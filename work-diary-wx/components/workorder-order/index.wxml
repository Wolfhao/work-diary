<view class="order-container">
  <view class="search-wrap">
    <t-search placeholder="搜索商单" value="{{searchValue}}" bind:change="onSearchChange" bind:clear="onSearchChange" bind:submit="onSearchChange" shape="round" clearable></t-search>
  </view>

  <t-tabs defaultValue="0" bind:change="onTabsChange" t-class="custom-tabs" t-class-content="custom-panel" theme="tag">
    <t-tab-panel label="全部" value="0">
      <order-list wx:if="{{activeTab === '0' || listData[0].length > 0}}" orderList="{{listData[0]}}" loading="{{loading}}" hasMore="{{hasMore[0]}}" bind:action="onOrderAction" />
    </t-tab-panel>
    <t-tab-panel label="制作中" value="1">
      <order-list wx:if="{{activeTab === '1' || listData[1].length > 0}}" orderList="{{listData[1]}}" loading="{{loading}}" hasMore="{{hasMore[1]}}" bind:action="onOrderAction" />
    </t-tab-panel>
    <t-tab-panel label="待结款" value="2">
      <order-list wx:if="{{activeTab === '2' || listData[2].length > 0}}" orderList="{{listData[2]}}" loading="{{loading}}" hasMore="{{hasMore[2]}}" bind:action="onOrderAction" />
    </t-tab-panel>
  </t-tabs>

  <t-toast id="t-toast" />
</view>
